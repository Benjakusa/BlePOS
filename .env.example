APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Production checklist: APP_ENV=production, APP_DEBUG=false, APP_KEY set,
# SESSION_SECURE_COOKIE=true, PLATFORM_FORCE_HTTPS=true, non-SQLite DB,
# S3-compatible FILESYSTEM_DISK and BACKUP_DISK, persistent queue/cache stores,
# and TRUSTED_PROXIES configured. Run platform:production-check before deploy.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=blepos_tenant_session
SESSION_LIFETIME=120
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_COOKIE=blepos_platform_session
PLATFORM_SESSION_EXPIRE_ON_CLOSE=true
PLATFORM_SESSION_PATH=/
PLATFORM_SESSION_DOMAIN=
PLATFORM_SESSION_SECURE_COOKIE=
PLATFORM_SESSION_SAME_SITE=lax
PLATFORM_SESSION_PARTITIONED_COOKIE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null
PLATFORM_FORCE_HTTPS=
PLATFORM_IP_ALLOWLIST_ENABLED=false
PLATFORM_IP_ALLOWLIST=
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BACKUP_DISK=local
PLATFORM_BACKUP_RETENTION_DAYS=30
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Use a random 32-byte key (base64: prefix + base64 encoding is supported).
MPESA_ENCRYPTION_KEY=
# After adopting versioned keyrings, keep old key versions configured until all ciphertext is re-encrypted.
MPESA_ENCRYPTION_KEYS={}
MPESA_ENCRYPTION_ACTIVE_KEY_VERSION=v1
MPESA_CALLBACK_ALLOWED_IPS=
MPESA_CALLBACK_SECRET=
MPESA_ALLOW_PLATFORM_FALLBACK_FOR_TENANT_SALES=false
